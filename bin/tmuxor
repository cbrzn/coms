#!/usr/bin/env bash
# Launch a team of Claude Code agents that talk to each other through a human
# gate. Each agent gets its own tmux session and its own git worktree.
#
#   tmuxor <repo> [--team FILE] [--roles DIR] [--task "..."] [--clean]
#
# The team file lists one agent per line:
#
#   claude specifier
#   claude builder
#   claude tester
#
# The first agent is the entry point unless another is marked --entry. Each
# needs a prompt at <roles>/<name>.md.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOOK="$HERE/hooks/relay-stop.sh"
BROKER="$HERE/bin/tmuxor-broker"

# acceptEdits only covers file edits — Bash still prompts, which stalls an agent
# mid-turn and defeats the point of watching only the broker. 'auto' lets the
# classifier approve routine work and stop the genuinely risky calls.
PERM=auto
TEAM=""; ROLEDIR=""; TASK=""; CLEAN=0; REPO=""
while [ $# -gt 0 ]; do
  case $1 in
    --team)  TEAM=$2; shift 2 ;;
    --roles) ROLEDIR=$2; shift 2 ;;
    --task)  TASK=$2; shift 2 ;;
    --perm)  PERM=$2; shift 2 ;;
    --yolo)  PERM=bypassPermissions; shift ;;
    --clean) CLEAN=1; shift ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) REPO=$1; shift ;;
  esac
done

[ -n "$REPO" ] || { echo "usage: tmuxor <repo> [--team FILE] [--roles DIR] [--task \"...\"]" >&2; exit 1; }
REPO=$(cd "$REPO" && git rev-parse --show-toplevel) || { echo "not a git repo: $REPO" >&2; exit 1; }
TEAM=${TEAM:-$( [ -f "$REPO/team.txt" ] && echo "$REPO/team.txt" || echo "$HERE/team.txt" )}
ROLEDIR=${ROLEDIR:-$( [ -d "$REPO/roles" ] && echo "$REPO/roles" || echo "$HERE/roles" )}
[ -f "$TEAM" ] || { echo "no team file: $TEAM" >&2; exit 1; }

TMUXOR_HOME="$REPO/.tmuxor"
WT="$REPO/.claude-worktrees"

# --- parse the team file ------------------------------------------------------
ROLES=(); ENTRY=""
while read -r cmd name rest || [ -n "${cmd:-}" ]; do
  case ${cmd:-} in ''|'#'*) continue ;; esac
  [ -n "${name:-}" ] || { echo "malformed team line: $cmd" >&2; exit 1; }
  [ -f "$ROLEDIR/$name.md" ] || { echo "missing role prompt: $ROLEDIR/$name.md" >&2; exit 1; }
  ROLES+=("$name")
  case ${rest:-} in *--entry*) ENTRY=$name ;; esac
done <"$TEAM"
[ ${#ROLES[@]} -ge 2 ] || { echo "need at least 2 agents" >&2; exit 1; }
ENTRY=${ENTRY:-${ROLES[0]}}

if [ "$CLEAN" = 1 ]; then
  for r in "${ROLES[@]}"; do
    tmux kill-session -t "tmuxor-$r" 2>/dev/null || true
    git -C "$REPO" worktree remove --force "$WT/tmuxor-$r" 2>/dev/null || true
    git -C "$REPO" branch -D "tmuxor/$r" 2>/dev/null || true
  done
  tmux kill-session -t tmuxor-broker 2>/dev/null || true
  rm -rf "$TMUXOR_HOME"
  echo "cleaned."
fi

for r in "${ROLES[@]}"; do
  tmux has-session -t "tmuxor-$r" 2>/dev/null && {
    echo "session tmuxor-$r already exists; re-run with --clean" >&2; exit 1; }
done

mkdir -p "$TMUXOR_HOME/queue"

# --- worktrees ----------------------------------------------------------------
for r in "${ROLES[@]}"; do
  [ -d "$WT/tmuxor-$r" ] && continue
  git -C "$REPO" worktree add -q -b "tmuxor/$r" "$WT/tmuxor-$r" HEAD 2>/dev/null \
    || git -C "$REPO" worktree add -q "$WT/tmuxor-$r" "tmuxor/$r"
done

# One-line gloss of a teammate, for the roster block.
summary() { grep -m1 -vE '^[[:space:]]*(#|$)' "$ROLEDIR/$1.md" | cut -c1-90; }
up()      { tr '[:lower:]' '[:upper:]' <<<"$1"; }

# --- prompts, settings, launchers --------------------------------------------
for r in "${ROLES[@]}"; do
  jq -n --arg cmd "$HOOK" \
    '{hooks:{Stop:[{hooks:[{type:"command",command:$cmd}]}]}}' \
    >"$TMUXOR_HOME/settings-$r.json"

  # Your role file verbatim, then a generated block telling this agent who else
  # exists and how to address them. The roster is generated because it changes
  # with the team file, and a stale hand-written one routes messages into a void.
  {
    cat "$ROLEDIR/$r.md"
    echo; echo "---"; echo
    echo "You are $(up "$r"), one agent in a team working on the same repository."
    echo "You each have your own git worktree. Your teammates:"
    echo
    for o in "${ROLES[@]}"; do
      [ "$o" = "$r" ] && continue
      printf '  %-12s %s\n' "$o" "$(summary "$o")"
      printf '  %-12s   worktree: %s\n' "" "$WT/tmuxor-$o"
    done
    cat <<EOF

## Addressing a teammate

Put a routing line on a line of its own, ideally the first line:

    [TO: <teammate>]

Include exactly one. Only your final message of a turn is relayed; if it carries
no routing line, or more than one, it stops at the operator who must pick a
recipient by hand.

Use [TO: human] when you need the operator rather than a teammate, and
[TO: done] when the work is finished and the chain should stop.

## What the others can see

Nothing except the message you send. Your tool calls, your thinking and your
terminal output are invisible to them. Make each message self-contained: what
you did, what you want from the recipient, and any specific question. Reference
concrete file paths. Keep it short — this is a conversation, not a report.

A human reviews every message before it is relayed, and may edit, retarget or
drop it. You may only write inside your own worktree, but you can read the
others' to see what they did.
EOF
  } >"$TMUXOR_HOME/prompt-$r.txt"

  # tmux runs pane commands through sh (dash here), which does not understand
  # the $'...' quoting bash emits for multi-line strings. A launcher script per
  # role keeps the pane command a bare path, and stays inspectable.
  {
    echo '#!/usr/bin/env bash'
    printf 'exec claude \\\n'
    printf '  --settings %q \\\n'                  "$TMUXOR_HOME/settings-$r.json"
    printf '  --permission-mode %q \\\n'           "$PERM"
    printf '  --append-system-prompt-file %q \\\n' "$TMUXOR_HOME/prompt-$r.txt"
    for o in "${ROLES[@]}"; do
      [ "$o" = "$r" ] && continue
      printf '  --add-dir %q \\\n' "$WT/tmuxor-$o"
    done
    printf '  "$@"\n'
  } >"$TMUXOR_HOME/launch-$r.sh"
  chmod +x "$TMUXOR_HOME/launch-$r.sh"
done

# --- sessions -----------------------------------------------------------------
# One session per agent. Pane ids are unique across the whole tmux server, so
# the broker can paste into any of them from its own session.
: >"$TMUXOR_HOME/panes.tsv"
for r in "${ROLES[@]}"; do
  pane=$(tmux new-session -d -P -F '#{pane_id}' -s "tmuxor-$r" -x 200 -y 50 \
    -c "$WT/tmuxor-$r" \
    -e TMUXOR_HOME="$TMUXOR_HOME" -e TMUXOR_ROLE="$r" \
    "$TMUXOR_HOME/launch-$r.sh")
  printf '%s\t%s\t%s\n' "$r" "$pane" "tmuxor-$r" >>"$TMUXOR_HOME/panes.tsv"
done

# Broker last, so panes.tsv is complete before it reads it.
tmux new-session -d -s tmuxor-broker -x 200 -y 50 -c "$REPO" \
  -e TMUXOR_HOME="$TMUXOR_HOME" "$BROKER"

if [ -n "$TASK" ]; then
  sleep 4   # let the TUI finish starting before pasting
  printf '%s' "$TASK" >"$TMUXOR_HOME/task.txt"
  entry_pane=$(awk -v r="$ENTRY" '$1==r{print $2}' "$TMUXOR_HOME/panes.tsv")
  tmux load-buffer -b tmuxor-task "$TMUXOR_HOME/task.txt"
  tmux paste-buffer -p -b tmuxor-task -t "$entry_pane"
  sleep 0.4
  tmux send-keys -t "$entry_pane" Enter
fi

column -t "$TMUXOR_HOME/panes.tsv"
echo "entry:  $ENTRY"
echo "attach: tmux attach -t tmuxor-broker"
