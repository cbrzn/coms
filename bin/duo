#!/usr/bin/env bash
# Launch two Claude Code instances that talk to each other through a human gate.
#
#   duo <repo> [--task "opening instruction for builder"] [--clean]
#
# Layout: builder and critic side by side, broker underneath. Each agent works
# in its own git worktree and can read (not write) the other's, so the critic
# can actually see the code it is reviewing.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HOOK="$HERE/hooks/relay-stop.sh"
BROKER="$HERE/bin/duo-broker"
SESSION=duo

# acceptEdits only covers file edits — Bash still prompts, which stalls a pane
# and defeats the point of watching only the broker. 'auto' lets the classifier
# approve routine work and stop the genuinely risky calls. --yolo removes even
# that; the worktree bounds writes to the repo, not what a shell command can do.
PERM=auto
TASK=""; CLEAN=0; REPO=""
while [ $# -gt 0 ]; do
  case $1 in
    --task)  TASK=$2; shift 2 ;;
    --perm)  PERM=$2; shift 2 ;;
    --yolo)  PERM=bypassPermissions; shift ;;
    --clean) CLEAN=1; shift ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) REPO=$1; shift ;;
  esac
done

[ -n "$REPO" ] || { echo "usage: duo <repo> [--task \"...\"] [--clean]" >&2; exit 1; }
REPO=$(cd "$REPO" && git rev-parse --show-toplevel) || { echo "not a git repo: $REPO" >&2; exit 1; }

DUO_HOME="$REPO/.duo"
WT="$REPO/.claude-worktrees"
BUILDER_WT="$WT/duo-builder"
CRITIC_WT="$WT/duo-critic"

if [ "$CLEAN" = 1 ]; then
  tmux kill-session -t "$SESSION" 2>/dev/null || true
  for w in "$BUILDER_WT" "$CRITIC_WT"; do
    git -C "$REPO" worktree remove --force "$w" 2>/dev/null || true
  done
  git -C "$REPO" branch -D duo/builder duo/critic 2>/dev/null || true
  rm -rf "$DUO_HOME"
  echo "cleaned."
fi

tmux has-session -t "$SESSION" 2>/dev/null && {
  echo "session '$SESSION' already exists. attach with: tmux attach -t $SESSION" >&2
  echo "(or re-run with --clean to start over)" >&2; exit 1; }

mkdir -p "$DUO_HOME/queue"

make_wt() { # $1=path $2=branch
  [ -d "$1" ] && return 0
  git -C "$REPO" worktree add -q -b "$2" "$1" HEAD 2>/dev/null \
    || git -C "$REPO" worktree add -q "$1" "$2"
}
make_wt "$BUILDER_WT" duo/builder
make_wt "$CRITIC_WT"  duo/critic

# Same repo, so a committed .claude/settings.json would apply to both instances.
# Each role gets its own settings file instead, and identity travels as env.
for role in builder critic; do
  jq -n --arg cmd "$HOOK" \
    '{hooks:{Stop:[{hooks:[{type:"command",command:$cmd}]}]}}' \
    >"$DUO_HOME/settings-$role.json"
done

prompt_for() {
  local me=$1 peer=$2
  cat <<EOF
You are $me, one of two Claude Code instances pairing on the same repository.
Your peer is $peer. You each work in your own git worktree.

- Messages from your peer arrive prefixed [FROM $peer]. A human reviews every
  message in both directions before it is relayed, and may edit or drop it.
- ONLY your final message of a turn is relayed. Make it self-contained: what you
  did, what you want $peer to look at, and any specific question. Tool output and
  thinking are not visible to them.
- You can read your peer's worktree but must only write inside your own.
- Keep messages short. This is a conversation, not a report.
EOF
}

{ prompt_for BUILDER CRITIC
  echo "Your job: implement. Make the change, run what you can, then hand off for review."
} >"$DUO_HOME/prompt-builder.txt"

{ prompt_for CRITIC BUILDER
  echo "Your job: review BUILDER's work and push back where it is wrong, unclear, or"
  echo "untested. Read their worktree at $BUILDER_WT. Use your own worktree only to try"
  echo "things out; the implementation of record is theirs."
} >"$DUO_HOME/prompt-critic.txt"

# tmux runs pane commands through sh (dash here), which does not understand the
# $'...' quoting bash emits for multi-line strings. A launcher script per role
# keeps the command a bare path, and stays inspectable when something misbehaves.
write_launcher() { # $1=role $2=other worktree
  cat >"$DUO_HOME/launch-$1.sh" <<EOF
#!/usr/bin/env bash
exec claude \\
  --settings "$DUO_HOME/settings-$1.json" \\
  --permission-mode $PERM \\
  --add-dir "$2" \\
  --append-system-prompt-file "$DUO_HOME/prompt-$1.txt"
EOF
  chmod +x "$DUO_HOME/launch-$1.sh"
}
write_launcher builder "$CRITIC_WT"
write_launcher critic  "$BUILDER_WT"

tmux new-session -d -s "$SESSION" -x 220 -y 50 -c "$BUILDER_WT" \
  -e DUO_HOME="$DUO_HOME" -e DUO_ROLE=builder \
  "$DUO_HOME/launch-builder.sh"
P_BUILDER=$(tmux display-message -p -t "$SESSION" '#{pane_id}')

P_CRITIC=$(tmux split-window -h -P -F '#{pane_id}' -t "$SESSION" -c "$CRITIC_WT" \
  -e DUO_HOME="$DUO_HOME" -e DUO_ROLE=critic \
  "$DUO_HOME/launch-critic.sh")

# Written before the broker starts, and long before any turn can finish.
cat >"$DUO_HOME/panes.env" <<EOF
DUO_PANE_BUILDER=$P_BUILDER
DUO_PANE_CRITIC=$P_CRITIC
EOF

tmux split-window -v -f -l 16 -t "$SESSION" -c "$REPO" \
  -e DUO_HOME="$DUO_HOME" "$BROKER"

tmux select-pane -t "$P_BUILDER"

if [ -n "$TASK" ]; then
  sleep 4   # let the TUI finish starting before pasting
  printf '%s' "$TASK" >"$DUO_HOME/task.txt"
  tmux load-buffer -b duo-task "$DUO_HOME/task.txt"
  tmux paste-buffer -p -b duo-task -t "$P_BUILDER"
  sleep 0.4
  tmux send-keys -t "$P_BUILDER" Enter
fi

echo "builder=$P_BUILDER critic=$P_CRITIC"
echo "attach: tmux attach -t $SESSION"
