#!/usr/bin/env bash
# The human review gate. Watches the queue for messages parked by the Stop
# hook, shows you each one, and only relays it to the peer if you say so.
set -uo pipefail

DUO_HOME=${DUO_HOME:?duo-broker must be launched by duo}
. "$DUO_HOME/panes.env"

bold=$'\e[1m'; dim=$'\e[2m'; grn=$'\e[32m'; ylw=$'\e[33m'; cyn=$'\e[36m'; off=$'\e[0m'

peer_of() { case $1 in builder) echo critic ;; *) echo builder ;; esac; }
pane_of() { case $1 in builder) echo "$DUO_PANE_BUILDER" ;; *) echo "$DUO_PANE_CRITIC" ;; esac; }

# Deliver via bracketed paste so multi-line survives intact, then submit with a
# separate Enter. Sending the text and the newline together makes the TUI submit
# at the first line break.
deliver() {
  local pane=$1 file=$2 from=$3
  local wrapped; wrapped=$(mktemp "${TMPDIR:-/tmp}/duo-send.XXXXXX")
  # The receiver's system prompt tells it peer messages look like this. Without
  # the tag it cannot tell the peer apart from you typing into its pane.
  { printf '[FROM %s]\n\n' "$(echo "$from" | tr '[:lower:]' '[:upper:]')"; cat "$file"; } >"$wrapped"
  tmux load-buffer -b duo "$wrapped"
  tmux paste-buffer -p -b duo -t "$pane"
  sleep 0.4
  tmux send-keys -t "$pane" Enter
  rm -f "$wrapped"
}

log() { printf '%s\n' "$*" >>"$DUO_HOME/relay.log"; }

printf '%s\n' "${bold}duo broker${off} ${dim}— nothing is relayed without your approval${off}"
printf '%s\n' "${dim}queue: $DUO_HOME/queue${off}"
echo

while true; do
  msg=$(find "$DUO_HOME/queue" -maxdepth 1 -name '*.json' 2>/dev/null | sort | head -1)
  if [ -z "$msg" ]; then sleep 0.5; continue; fi

  from=$(jq -r '.from' "$msg")
  to=$(peer_of "$from")
  body=$(mktemp "${TMPDIR:-/tmp}/duo-msg.XXXXXX")
  jq -r '.text' "$msg" >"$body"

  while true; do
    echo "${cyn}────────────────────────────────────────────────────────${off}"
    printf '%s\n' "${bold}${from}${off} ${dim}→${off} ${bold}${to}${off}  ${dim}($(wc -l <"$body") lines, $(wc -c <"$body") bytes)${off}"
    echo "${cyn}────────────────────────────────────────────────────────${off}"
    cat "$body"
    echo "${cyn}────────────────────────────────────────────────────────${off}"
    printf '%s' "${grn}[s]${off}end  ${ylw}[e]${off}dit  ${ylw}[d]${off}rop  ${dim}[q]uit${off} > "
    read -r -n1 key </dev/tty; echo

    case $key in
      s|S)
        deliver "$(pane_of "$to")" "$body" "$from"
        log "$(date -Is) $from -> $to $(wc -c <"$body") bytes"
        echo "${grn}sent to $to${off}"; echo
        break ;;
      e|E)
        "${EDITOR:-nano}" "$body" </dev/tty >/dev/tty 2>&1
        continue ;;
      d|D)
        log "$(date -Is) $from -> $to DROPPED"
        echo "${ylw}dropped${off}"; echo
        break ;;
      q|Q)
        rm -f "$body"; echo "bye"; exit 0 ;;
      *) continue ;;
    esac
  done

  rm -f "$msg" "$body"
done
